# ---------------------------------------------------------------------------
# HaulPair — environment configuration (copy to .env and adjust).
# Never commit .env. Values here are safe examples only.
# ---------------------------------------------------------------------------

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Human-readable logs in development (requires devDependency pino-pretty)
LOG_PRETTY=true
# Set to true only when running behind a reverse proxy you control.
# On Render (TLS terminated at a proxy) set TRUST_PROXY=true, or per-IP rate limits
# lump all clients into one bucket. Do NOT set it broader than one hop.
TRUST_PROXY=false

# --- Access protection (shared HTTP Basic) -----------------------------------
# MANDATORY in production: the app refuses to start publicly without credentials.
# Shared single login — it keeps anonymous visitors out; it is NOT multi-tenant
# per-user auth and does not isolate testers' data. Set these in server secrets.
AUTH_ENABLED=false
AUTH_USERNAME=
AUTH_PASSWORD=
AUTH_REALM=HaulPair (shared prototype access)

# --- PostgreSQL --------------------------------------------------------------
# Matches docker-compose.yml. Change the password for anything beyond local use.
DATABASE_URL=postgres://grain:grain_dev_password@localhost:5432/grain_transport
DATABASE_SSL=false
DATABASE_POOL_MAX=10
# Optional: separate database for `npm run test:integration` (it is wiped by the tests!)
TEST_DATABASE_URL=postgres://grain:grain_dev_password@localhost:5432/grain_transport_test

# --- Routing -----------------------------------------------------------------
# osrm             = public OSRM demo server, CAR profile only, non-commercial light use, no key.
# openrouteservice = driving-hgv (truck) profile with vehicle restrictions, needs ORS_API_KEY.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ORS_BASE_URL=https://api.openrouteservice.org
# Get a free key at https://openrouteservice.org/dev/#/signup. Server-side only.
ORS_API_KEY=

# --- End-user booking flow ---------------------------------------------------
# Truck routing for quotes, orders and the price planner:
#   auto             = openrouteservice "driving-hgv" with the auto-selected truck's weight,
#                      height, width, length and axle-load limits when ORS_API_KEY is set;
#                      otherwise a clearly labelled DEMO route (the app still runs without keys).
#   openrouteservice = require ORS (startup fails without ORS_API_KEY)
#   demo             = always use the labelled DEMO route
# ORS Standard (free) plan, per its plans page at the time of writing: Directions 2,000
# requests/day and 40/minute. Verify current limits and terms before going live.
TRUCK_ROUTING_PROVIDER=auto
# Optional override of data/booking/pricing.json marginPct (backend only, never shown to users).
PRICING_MARGIN_PCT=
# When AI is ready, refresh the stored diesel price once it is older than this many hours.
DIESEL_AI_REFRESH_HOURS=12
# The legacy advanced planner (/advanced.html + its technical API) is an internal tool and
# is hidden from end users unless enabled. Fuel price and cost breakdowns live there.
ADVANCED_TOOLS_ENABLED=false

# --- Geocoding (location search) ----------------------------------------------
# photon           = public Photon instance (komoot), fair-use, no key
# openrouteservice = ORS geocoding autocomplete, uses ORS_API_KEY
GEOCODER_PROVIDER=photon
PHOTON_BASE_URL=https://photon.komoot.io

# Identify your application to OSM-community services (required by their policies).
APP_USER_AGENT=HaulPairPlanner/0.2 (contact: replace-with-your-email@example.com)
EXTERNAL_TIMEOUT_MS=10000

# --- Map tiles (loaded directly by the browser) ------------------------------
# Default: OpenStreetMap standard tiles — development/low traffic only, per the OSMF tile policy.
# For production use a commercial tile host or self-hosted tiles, e.g.
#   MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/osm_bright/{z}/{x}/{y}.png
#   MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_DOMAIN_RESTRICTED_KEY
# Keys in tile URLs are visible to browsers: use keys restricted to your domain.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
MAP_TILE_MAX_ZOOM=19

# --- Route tokens ------------------------------------------------------------
# HMAC secret that signs route results so calculations use provider distances.
# Required in production; generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROUTE_TOKEN_SECRET=
ROUTE_TOKEN_TTL_S=3600

# --- Rate limits (per client IP, per window) ---------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_ROUTES_MAX=20
RATE_LIMIT_GEOCODE_MAX=60

# --- Shared external-service ceilings (routing + geocoding + AI) --------------
# On top of per-IP limits: a shared daily cap and concurrency bound for all paid/
# limited provider calls. In-process counters (adequate for one instance; a
# multi-instance deploy needs a shared store — see docs).
EXTERNAL_DAILY_MAX=2000
EXTERNAL_MAX_CONCURRENT=6
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AI_MAX=10

# --- AI — Google Gemini only (OFF by default) ----------------------------------
# In the end-user app the AI manages exactly ONE input: the current Lithuanian diesel
# price (Gemini + Google Search grounding, validated 1.0–3.5 EUR/l, cached with a
# timestamp, last known good value kept on failure). All price arithmetic is code.
# The legacy "describe shipment" helper is only reachable with ADVANCED_TOOLS_ENABLED=true.
# Budget for extra AI cost: 0 EUR. No paid plan, no auto-reload, no provider switch.
# A key alone is NOT proof of free usage — verify free-tier eligibility for YOUR
# project, model and region (EU) in Google AI Studio / Google Cloud before enabling.
# See docs/ai-gemini-setup.md. Leave AI_ENABLED=false if a paid plan would be required.
AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_DAILY_MAX=50
AI_MAX_INPUT_CHARS=2000
AI_TIMEOUT_MS=15000

# --- Fuel price suggestion (LEA) — independent of AI; manual entry always works ---
# Automatic LEA ingestion is NOT verified/connected; prices arrive via admin import
# (POST /api/fuel-price/import with X-Admin-Token). Manual entry works regardless.
FUEL_PRICE_ENABLED=false
FUEL_PRICE_SOURCE_URL=
FUEL_PRICE_ADMIN_TOKEN=
FUEL_PRICE_MAX_AGE_HOURS=48
